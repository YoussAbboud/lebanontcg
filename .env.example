# --- Mock mode (default for development) ---------------------------------
# 1 = run fully offline against the in-memory MockClient (no credentials
# needed, dev user-switcher enabled). 0 = run against a real Supabase
# project using the variables below.
VITE_MOCK=1

# --- Live mode (Supabase) -------------------------------------------------
# Project URL, e.g. https://abcdefghij.supabase.co
# Found in: Supabase dashboard -> Project Settings -> General
VITE_SUPABASE_URL=

# The public browser key (safe to expose; RLS enforces access).
# New projects: "Publishable key" (sb_publishable_...) in Project
# Settings -> API Keys. Older projects: the "anon public" key.
# NEVER use the secret / service_role key here.
VITE_SUPABASE_ANON_KEY=
